## Managed by Ansible - Do NOT edit manually
## Generated from: roles/dns_bind/templates/named.conf.j2

options {
    listen-on port 53 { {{  dns_listen_on | join('; ') }}; };
    listen-on-v6 port 53 { none; };
    directory           "{{ bind_zones_dir }}";
    dump-file           "/var/named/data/cache_dump.db";
    statistics-file     "/var/named/data/named_stats.txt";
    memstatistic-file   "/var/named/data/named_mem_stats.txt";
    recursing-file      "/var/named/data//named.recursing";
    secroots-file       "/var/named/data/named.secroots";
    allow-query         { {{  dns_allow_query | join('; ') }}; };

    recursion {{ 'yes' if dns_recursion else 'no' }};

{% if dns_forwarders_enabled and dns_forwarders | length > 0 %}
    forwarders {
{% for fwd in dns_forwarders %}
        {{ fwd }};
{% endfor %}
    };
    forward only;
{% endif %}

    dnssec-validation yes;

    managed-keys-directory "/var/named/dynamic";
    pid-file "/run/named/named.pid";
    session-keyfile "/run/named/session.key";
};

logging {
    channel default_debug {
        file "data/named.run";
        severity dynamic;
    };
};

zone "." IN {
    type hint;
    file "named.ca";
};

zone "{{ domain_name }}" IN {
    type master;
    file "{{ zone_forward_file }}";
    allow-update { none; };
};

zone "{{ reverse_zone }}" IN {
    type master;
    file "{{ zone_reverse_file }}";
    allow-update { none; };
};

include "/etc/named.rfc1912.zones";
include "/etc/named.root.key";